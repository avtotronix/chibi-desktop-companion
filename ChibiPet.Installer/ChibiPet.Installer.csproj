<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>installer.ico</ApplicationIcon>
    <AssemblyName>ChibiPet-Setup</AssemblyName>
    <RootNamespace>ChibiPet.Installer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Payload\app.zip" Condition="Exists('Payload\app.zip')" />
  </ItemGroup>

</Project>
