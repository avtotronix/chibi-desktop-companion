<Window x:Class="ChibiPet.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChibiPet — Панель управления"
        Width="880" Height="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- Цветовая палитра -->
        <SolidColorBrush x:Key="BgDark" Color="#121218"/>
        <SolidColorBrush x:Key="CardBg" Color="#1A1A24"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2B2B3B"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#2EB85C"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#3AD56D"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>

        <!-- Стиль переключателей вкладок навигации -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#222230"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2A3C"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль интерактивных кнопок эмоций -->
        <Style x:Key="EmotionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#20202E"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2E2E42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#2D2D40"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль чекбоксов -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Основная рамка окна -->
    <Border Background="{StaticResource BgDark}" CornerRadius="14" BorderBrush="#353545" BorderThickness="1.2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Titlebar -->
                <RowDefinition Height="46"/> <!-- Tab bar -->
                <RowDefinition Height="*"/>  <!-- Active Tab Content -->
            </Grid.RowDefinitions>

            <!-- 1. Заголовок окна -->
            <Border Grid.Row="0" Background="#181820" CornerRadius="14,14,0,0" BorderBrush="#252532" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👾" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ChibiPet" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                        <Border Background="#2A3B2A" CornerRadius="6" Margin="10,0,0,0" Padding="6,2">
                            <TextBlock Text="Minecraft Edition" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnHidePet" Content="▼" Width="34" Height="28" Background="Transparent" Foreground="#60A5FA"
                                BorderThickness="0" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnHidePet_Click"
                                ToolTip="Скрыть чибика с экрана (стрелочка вниз)"/>
                        <Button Content="🗕" Width="34" Height="28" Background="Transparent" Foreground="#AAAAAA"
                                BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnMinimize_Click" Margin="2,0,0,0"
                                ToolTip="Свернуть окно"/>
                        <Button Content="✕" Width="34" Height="28" Background="Transparent" Foreground="#AAAAAA"
                                BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnCloseLauncher_Click" Margin="2,0,0,0"
                                ToolTip="Закрыть меню (чибик останется на экране)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Навигационные вкладки -->
            <Border Grid.Row="1" Background="#14141B" BorderBrush="#252532" BorderThickness="0,0,0,1" Padding="16,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabBtnSettings" Content="🎮 3D-Студия &amp; Настройки" GroupName="NavTabs" IsChecked="True"
                                 Style="{StaticResource NavTabStyle}" Click="TabSettings_Click"/>
                    <RadioButton x:Name="TabBtnEmotions" Content="🎭 Эмоции &amp; Действия" GroupName="NavTabs"
                                 Style="{StaticResource NavTabStyle}" Click="TabEmotions_Click" Margin="8,0,0,0"/>
                    <RadioButton x:Name="TabBtnAssistant" Content="⏰ Помощник &amp; Таймер" GroupName="NavTabs"
                                 Style="{StaticResource NavTabStyle}" Click="TabAssistant_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ================= ВКЛАДКА 1: 3D Студия & Настройки ================= -->
            <Grid x:Name="GridTabSettings" Grid.Row="2" Margin="20,16,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: 3D предпросмотр -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="3D Предпросмотр скина" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="вращай мышкой" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#14141B" CornerRadius="10" ClipToBounds="True" BorderBrush="#252535" BorderThickness="1"
                                MouseLeftButtonDown="Viewport_MouseDown" MouseLeftButtonUp="Viewport_MouseUp" MouseMove="Viewport_MouseMove" Cursor="SizeWE">
                            <Viewport3D x:Name="PreviewViewport">
                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <AmbientLight Color="#808085"/>
                                            <DirectionalLight Color="#FFFFFF" Direction="-0.5, -1.0, -0.7"/>
                                            <DirectionalLight Color="#353545" Direction="0.6, 0.4, 0.8"/>
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>
                                <ModelVisual3D x:Name="PreviewCharacter"/>
                            </Viewport3D>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button x:Name="BtnLoadSkin" Height="36" Background="{StaticResource AccentGreen}" Foreground="White"
                                    FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0" Click="BtnLoadSkin_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <TextBlock Text="📁 Загрузить свой скин (.PNG)" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <TextBlock Text="Пресеты:" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="Стив" Padding="10,4" Margin="3,0" Background="#282834" Foreground="{StaticResource TextMain}"
                                        BorderThickness="0" Cursor="Hand" Click="PresetSteve_Click"/>
                                <Button Content="Алекс (Slim)" Padding="10,4" Margin="3,0" Background="#282834" Foreground="{StaticResource TextMain}"
                                        BorderThickness="0" Cursor="Hand" Click="PresetAlex_Click"/>
                                <Button Content="Гань Юй" Padding="10,4" Margin="3,0" Background="#282834" Foreground="{StaticResource TextMain}"
                                        BorderThickness="0" Cursor="Hand" Click="PresetGanyu_Click"/>
                            </StackPanel>

                            <Border Background="#181820" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSkinName" Text="Скин: skin.png" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock x:Name="TxtSkinType" Text="Тип: Классический Minecraft (64×64)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Правая колонка: Настройки приложения -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Статус чибика -->
                    <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource AccentGreen}" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtStatus" Text="Чибик гуляет по экрану" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}"/>
                                    <TextBlock Text="Персонаж находится над панелью задач" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="BtnTogglePet" Content="Остановить" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="14,6" Background="#282838" Foreground="{StaticResource TextMain}" BorderThickness="0" Cursor="Hand" Click="BtnTogglePet_Click"/>
                        </Grid>
                    </Border>

                    <!-- Карточка параметров -->
                    <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Параметры персонажа" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" Margin="0,0,0,10"/>

                                <Grid>
                                    <TextBlock Text="Размер чибика на экране:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="LblScale" Text="100%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderScale" Minimum="3.0" Maximum="10.0" Value="5.5" SmallChange="0.5" ValueChanged="SliderScale_ValueChanged"/>

                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Скорость ходьбы:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="LblSpeed" Text="50 px/s" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SliderSpeed" Minimum="20" Maximum="120" Value="50" SmallChange="5" ValueChanged="SliderSpeed_ValueChanged"/>

                                <TextBlock Text="Пропорции тела:" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <RadioButton x:Name="RadioStyleClassic" Content="Аутентичный Minecraft (1:1)" IsChecked="True" Foreground="{StaticResource TextMain}" Margin="0,0,14,0" Checked="RadioStyle_Checked"/>
                                    <RadioButton x:Name="RadioStyleChibi" Content="Милый Чибик" Foreground="{StaticResource TextMain}" Checked="RadioStyle_Checked"/>
                                </StackPanel>

                                <Separator Background="#2B2B3B" Margin="0,4,0,10"/>

                                <!-- Секция: Женская моделька (Wildfire's Female Gender Mod) -->
                                <Border Background="#1C1826" CornerRadius="10" BorderBrush="#3D2B4A" BorderThickness="1.2" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎀" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Женская моделька (Wildfire Gender)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkFemaleGender" Content="Включить" FontWeight="SemiBold" HorizontalAlignment="Right" Click="ChkFemaleGender_Click"/>
                                        </Grid>

                                        <StackPanel x:Name="PanelFemaleSettings" Visibility="Collapsed" Margin="0,4,0,0">
                                            <!-- Размер груди (Bust Size) -->
                                            <Grid Margin="0,3,0,0">
                                                <TextBlock Text="Размер груди (Bust Size):" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="LblBreastSize" Text="65%" FontSize="11" FontWeight="Bold" Foreground="#F472B6" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderBreastSize" Minimum="0.1" Maximum="1.2" Value="0.65" SmallChange="0.05" ValueChanged="SliderBreast_ValueChanged"/>

                                            <!-- Выступ вперёд (Depth / Z-Offset) -->
                                            <Grid Margin="0,3,0,0">
                                                <TextBlock Text="Выступ вперёд (Depth):" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="LblBreastDepth" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#F472B6" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderBreastDepth" Minimum="0.5" Maximum="2.0" Value="1.0" SmallChange="0.1" ValueChanged="SliderBreast_ValueChanged"/>

                                            <!-- Высота (Y-Offset) -->
                                            <Grid Margin="0,3,0,0">
                                                <TextBlock Text="Положение по высоте (Y-Offset):" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="LblBreastYOffset" Text="0.0" FontSize="11" FontWeight="Bold" Foreground="#F472B6" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderBreastYOffset" Minimum="-1.5" Maximum="1.5" Value="0.0" SmallChange="0.1" ValueChanged="SliderBreast_ValueChanged"/>

                                            <!-- Разделение / форма (Cleavage) -->
                                            <Grid Margin="0,3,0,0">
                                                <TextBlock Text="Разделение / Ложбинка (Cleavage):" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="LblCleavage" Text="0.25" FontSize="11" FontWeight="Bold" Foreground="#F472B6" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderCleavage" Minimum="0.05" Maximum="0.6" Value="0.25" SmallChange="0.05" ValueChanged="SliderBreast_ValueChanged"/>

                                            <!-- Физика покачивания (Bounce Physics) -->
                                            <CheckBox x:Name="ChkBreastPhysics" Content="💃 Физика покачивания (Bounce / Jiggle)" IsChecked="True" Click="ChkBreastPhysics_Click" Margin="0,6,0,2"/>

                                            <!-- Сила покачивания -->
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="Интенсивность покачивания:" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock x:Name="LblBounceIntensity" Text="100%" FontSize="11" FontWeight="Bold" Foreground="#F472B6" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="SliderBounceIntensity" Minimum="0.0" Maximum="2.0" Value="1.0" SmallChange="0.1" ValueChanged="SliderBreast_ValueChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Separator Background="#2B2B3B" Margin="0,4,0,10"/>

                                <CheckBox x:Name="ChkSleepGames" Content="🎮 Спать во время игр (кроме Minecraft)" IsChecked="True" Click="ChkSleepGames_Click"/>
                                <CheckBox x:Name="ChkTopmost" Content="🪟 Отображать поверх всех окон" IsChecked="True" Click="ChkTopmost_Click"/>
                                <CheckBox x:Name="ChkAutoRun" Content="🚀 Запускать вместе с Windows" Click="ChkAutoRun_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Нижние кнопки -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="✕ Закрыть всё" HorizontalAlignment="Left" Padding="14,8" Background="#2E1C1C" Foreground="#FF8888" BorderThickness="0" Cursor="Hand" Click="BtnExitAll_Click"/>
                        <Button Content="Свернуть в трей (чибик останется)" HorizontalAlignment="Right" Padding="16,8" Background="#1E3A5F" Foreground="#60A5FA" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnMinimizeToTray_Click"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= ВКЛАДКА 2: Эмоции & Действия ================= -->
            <Grid x:Name="GridTabEmotions" Grid.Row="2" Margin="20,16,20,20" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Сетка интерактивных эмоций -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="🎭 Эмоции персонажа" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                            <TextBlock Text="Нажми на любую эмоцию — чибик сразу воспроизведёт её на экране!" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2" Margin="0,0,0,16">
                                <Button Content="❤️ Радость (Hearts)" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="EmotionJoy_Click"/>
                                <Button Content="😭 Плач (Tears)" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="EmotionCry_Click"/>
                                <Button Content="💢 Злость (Anger)" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="EmotionAngry_Click"/>
                                <Button Content="😱 Испуг (Scared)" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="EmotionScared_Click"/>
                                <Button Content="😳 Смущение (Blush)" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="EmotionBlush_Click"/>
                                <Button Content="🥱 Скука / Зевание" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="EmotionBored_Click"/>
                                <Button Content="💤 Лечь спать (Лицом к экрану)" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="EmotionSleep_Click"/>
                                <Button Content="☀️ Разбудить чибика" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="EmotionWake_Click"/>
                            </UniformGrid>

                            <Separator Background="#2B2B3B" Margin="0,4,0,14"/>

                            <TextBlock Text="🎮 Забавы и Действия" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                            <TextBlock Text="Интерактивные мини-игры и майнкрафтовские штучки:" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                            <UniformGrid Columns="2">
                                <Button Content="🎯 Ловить курсор мышки" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="ActionCatchCursor_Click"/>
                                <Button Content="🧗 Карабкаться по стене" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="ActionClimbWall_Click"/>
                                <Button Content="⛏️ Копать блок / Дерево" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="ActionMining_Click"/>
                                <Button Content="🎣 Ловить рыбку (с уловом)" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="ActionFishing_Click"/>
                                <Button Content="🎵 Танец под музыку" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="ActionDance_Click"/>
                                <Button Content="☀️ Разбудить / В центр" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="EmotionWake_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Правая колонка: Настройки авто-поведения -->
                <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚙️ Автоматические реакции" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"/>
                        <TextBlock Text="Чибик сам реагирует на происходящее:" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkAutoIdle" Content="🥱 Зевать через 5 минут простоя" IsChecked="True" Click="ChkAutoOptions_Click"/>
                        <TextBlock Text="Персонаж скучает, если мышка не двигается" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="20,0,0,10"/>

                        <CheckBox x:Name="ChkAutoSleep" Content="💤 Засыпать через 10 минут простоя" IsChecked="True" Click="ChkAutoOptions_Click"/>
                        <TextBlock Text="Ложится спать на полу лицом к экрану" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="20,0,0,10"/>

                        <CheckBox x:Name="ChkNightSleep" Content="🌙 Сон в ночное время (23:00–07:00)" IsChecked="True" Click="ChkAutoOptions_Click"/>
                        <TextBlock Text="Пожелает спокойной ночи и уснёт" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="20,0,0,10"/>

                        <CheckBox x:Name="ChkBattery" Content="🔋 Реакция на заряд батареи ноутбука" IsChecked="True" Click="ChkAutoOptions_Click"/>
                        <TextBlock Text="Зевает при &lt;20%, радуется при подключении" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="20,0,0,14"/>

                        <Border Background="#14141E" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 Подсказка:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentGreen}"/>
                                <TextBlock Text="Потяни чибика левой кнопкой мыши — он заплачет, закрывая ручками глазки! А если кликнуть — обрадуется сердечками."
                                           FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= ВКЛАДКА 3: Помощник & Помодоро ================= -->
            <Grid x:Name="GridTabAssistant" Grid.Row="2" Margin="20,16,20,20" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: Напоминания с пузырями над чибиком -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="💬 Таблички и Напоминания" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                        <TextBlock Text="Чибик выходит с красивой всплывающей табличкой над головой:" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <Button Content="💧 «Пора попить воды»" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="ReminderWater_Click"/>
                            <Button Content="👀 «Отдохни от экрана»" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="ReminderEyes_Click"/>
                            <Button Content="🧘 «Встань и разомнись»" Style="{StaticResource EmotionBtnStyle}" Margin="0,0,6,8" Click="ReminderStretch_Click"/>
                            <Button Content="☀️ «Хорошего дня!»" Style="{StaticResource EmotionBtnStyle}" Margin="6,0,0,8" Click="ReminderGoodDay_Click"/>
                        </UniformGrid>

                        <CheckBox x:Name="ChkWaterPeriodic" Content="💧 Авто-напоминания каждые 45 минут" IsChecked="True" Click="ChkWaterPeriodic_Click" Margin="0,6,0,14"/>

                        <Separator Background="#2B2B3B" Margin="0,4,0,14"/>

                        <TextBlock Text="📝 Своя заметка над чибиком:" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="TxtCustomNote" Height="36" Background="#14141E" Foreground="{StaticResource TextMain}"
                                     BorderBrush="#2E2E42" BorderThickness="1" Padding="8,8" FontSize="12" VerticalContentAlignment="Center"
                                     Text="Не забудь сделать важное дело! 📌"/>
                        </Grid>
                        <Button Content="Показать заметку над чибиком" Height="36" Background="{StaticResource AccentBlue}" Foreground="White"
                                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnSendCustomNote_Click"/>
                    </StackPanel>
                </Border>

                <!-- Правая колонка: Помодоро Таймер -->
                <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⏱️ Таймер и Помодоро" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                        <TextBlock Text="Чибик сидит рядом и звонит, когда время выйдет:" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14"/>

                        <!-- Дисплей таймера -->
                        <Border Background="#14141E" CornerRadius="12" BorderBrush="#2E2E42" BorderThickness="1" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtTimerDisplay" Text="25:00" FontSize="42" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtTimerStatus" Text="Готов к работе" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Кнопки выбора времени -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Button Content="25 мин" Padding="10,6" Margin="3,0" Background="#222230" Foreground="{StaticResource TextMain}" BorderThickness="0" Cursor="Hand" Click="TimerPreset_25"/>
                            <Button Content="5 мин" Padding="10,6" Margin="3,0" Background="#222230" Foreground="{StaticResource TextMain}" BorderThickness="0" Cursor="Hand" Click="TimerPreset_5"/>
                            <Button Content="15 мин" Padding="10,6" Margin="3,0" Background="#222230" Foreground="{StaticResource TextMain}" BorderThickness="0" Cursor="Hand" Click="TimerPreset_15"/>
                            <Button Content="45 мин" Padding="10,6" Margin="3,0" Background="#222230" Foreground="{StaticResource TextMain}" BorderThickness="0" Cursor="Hand" Click="TimerPreset_45"/>
                        </StackPanel>

                        <!-- Управление таймером -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTimerStart" Grid.Column="0" Content="▶ Запустить" Height="38" Background="{StaticResource AccentGreen}" Foreground="White"
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnTimerStart_Click"/>
                            <Button x:Name="BtnTimerReset" Grid.Column="2" Content="⏹ Сбросить" Height="38" Background="#282838" Foreground="{StaticResource TextMain}"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnTimerReset_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
